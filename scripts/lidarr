#!/usr/bin/env bash
# Thin wrapper around the Lidarr HTTP API. Handles auth, base URL, and the
# common queries I keep typing by hand.
#
# Subcommands:
#   summary              One-shot dashboard: queue, recent imports, errors, dups
#   queue                Counts by status + total
#   queue-list [N]       Show first N queue items (default 30)
#   dups                 Queue records grouped by downloadId (find duplication)
#   rejections [N]       Top N normalized rejection reasons (collapses paths/%s)
#   stuck [N]            Items in ImportFailed for the longest (default 20)
#   history [N]          Last N history events (default 20)
#   imports [N]          Last N trackFileImported events
#   imports-rate         Imports per minute over the last hour
#   grabs [N]            Last N grabbed (release picked up) events
#   status               System version + production flag
#   refresh              POST RefreshMonitoredDownloads
#   scan                 POST RescanFolders
#   command NAME [JSON]  Trigger an arbitrary command
#   raw PATH [curl args] Pass-through curl (e.g. raw '/queue?page=2')

set -euo pipefail
cd "$(git rev-parse --show-toplevel)"
source scripts/_common.sh

cmd=${1:-help}
shift || true

case "$cmd" in
  summary)
    # Combined dashboard. Single round trip to /queue + a few aggregations on
    # /history. Tells you in one glance: where the queue stands, what's churning,
    # what's failing, whether work is flowing.
    queue_json=$(lidarr_curl "/queue?pageSize=1000&includeUnknownArtistItems=true")
    hist_json=$(lidarr_curl "/history?pageSize=500&sortDirection=descending&sortKey=date")

    printf "${C_CYA}=== Service ===${C_RST}\n"
    lidarr_curl "/system/status" | jq -r '"  v\(.version)  build \(.buildTime)  up since \(.startTime)"'

    printf "\n${C_CYA}=== Queue ===${C_RST}\n"
    echo "$queue_json" | jq -r '
      def fmt_groups(field): if length == 0 then "(none)" else group_by(field) | map("\(.[0]|getpath([field|tostring]))=\(length)") | join(", ") end;
      .records as $rs |
      "  total: \(.totalRecords)" +
      (if ($rs|length) == 0 then "\n  (queue is empty)"
       else
         "\n  by status: \($rs | group_by(.status) | map("\(.[0].status)=\(length)") | join(", "))" +
         "\n  by trackedDownloadState: \($rs | group_by(.trackedDownloadState) | map("\(.[0].trackedDownloadState)=\(length)") | join(", "))" +
         "\n  distinct downloadIds: \($rs | map(.downloadId) | unique | length)" +
         "\n  duplication ratio: \(((($rs|length) * 100) / ($rs | map(.downloadId) | unique | length) | floor) / 100)x"
       end)'

    printf "\n${C_CYA}=== Top duplicating downloads (5) ===${C_RST}\n"
    echo "$queue_json" | jq -r '.records | group_by(.downloadId)
        | map({n: length, title: .[0].title})
        | sort_by(-.n) | .[0:5]
        | .[] | "  \(.n)x  \(.title)"'

    printf "\n${C_CYA}=== Imports per minute (last 30) ===${C_RST}\n"
    echo "$hist_json" | jq -r '[.records[] | select(.eventType == "trackFileImported") | .date | sub(":\\d+Z$"; "")]
        | group_by(.) | map({m: .[0], n: length}) | sort_by(.m) | reverse | .[0:30]
        | reverse | .[] | "  \(.m): \(.n)"'

    printf "\n${C_CYA}=== Top rejection reasons (10, normalized) ===${C_RST}\n"
    echo "$queue_json" | jq -r '[.records[].statusMessages[]?.messages[]?]
        | flatten | .[] | sub("\\d+(\\.\\d+)?\\s*%"; "X%"; "g") | sub("\\[.*\\]"; "[…]")' \
      | sort | uniq -c | sort -rn | head -10 | sed 's/^/  /'
    ;;

  queue)
    lidarr_curl "/queue?pageSize=1000&includeUnknownArtistItems=true" \
      | jq '{
          total: .totalRecords,
          shown: (.records | length),
          byStatus: (.records | group_by(.status)
                              | map({status: .[0].status, count: length})
                              | sort_by(-.count))
        }'
    ;;

  queue-list)
    n=${1:-30}
    lidarr_curl "/queue?pageSize=$n&includeUnknownArtistItems=true&sortKey=timeleft&sortDirection=ascending" \
      | jq -r '.records[] | "\(.status[0:9])\t\(.title)"'
    ;;

  rejections)
    n=${1:-20}
    # statusMessages may be missing or empty; flatten, normalize ("vs 50%" /
    # paths in brackets) and count. Without normalization the same logical
    # rejection appears N times under N slightly different formattings.
    lidarr_curl "/queue?pageSize=1000&includeUnknownArtistItems=true" \
      | jq -r '.records[] | (.statusMessages // [])[] | (.messages // [])[]
                  | sub("\\d+(\\.\\d+)?\\s*%"; "X%"; "g")
                  | sub("\\[.*\\]"; "[…]")' \
      | sort | uniq -c | sort -rn | head -"$n"
    ;;

  dups)
    # Show queue records grouped by downloadId — surfaces the duplication
    # problem (one download spawning many queue records).
    lidarr_curl "/queue?pageSize=1000&includeUnknownArtistItems=true" \
      | jq -r '.records | group_by(.downloadId)
                | map({n: length, title: .[0].title, status: .[0].status})
                | sort_by(-.n)
                | .[] | "\(.n)\t\(.status)\t\(.title)"' | head -30
    ;;

  imports-rate)
    # Per-minute import counts for the last hour. Useful right after a deploy
    # to see whether new code is causing imports to flow.
    lidarr_curl "/history?pageSize=500&eventType=3&sortDirection=descending" \
      | jq -r '[.records[].date | sub(":\\d+Z$"; "")]
                | group_by(.) | map({m: .[0], n: length}) | sort_by(.m) | reverse
                | .[0:60] | reverse | .[] | "\(.m)\t\(.n)"'
    ;;

  stuck)
    n=${1:-20}
    # Show queue items in errorMessage / warning state, oldest first by added date.
    lidarr_curl "/queue?pageSize=1000&includeUnknownArtistItems=true" \
      | jq -r '.records
                | map(select(.trackedDownloadStatus == "warning" or .trackedDownloadStatus == "error"))
                | sort_by(.added // "")
                | .[0:'"$n"']
                | .[] | "\(.added // "?")\t\(.trackedDownloadStatus)\t\(.title)"'
    ;;

  history)
    n=${1:-20}
    lidarr_curl "/history?pageSize=$n&sortDirection=descending&sortKey=date" \
      | jq -r '.records[] | "\(.date)\t\(.eventType)\t\(.sourceTitle)"'
    ;;

  imports)
    # eventType=3 is trackFileImported (per-track). Numeric API param.
    n=${1:-20}
    lidarr_curl "/history?pageSize=$n&eventType=3&sortDirection=descending&sortKey=date" \
      | jq -r '.records[] | "\(.date)\t\(.sourceTitle)"'
    ;;

  grabs)
    # eventType=1 is grabbed (release picked up).
    n=${1:-20}
    lidarr_curl "/history?pageSize=$n&eventType=1&sortDirection=descending&sortKey=date" \
      | jq -r '.records[] | "\(.date)\t\(.sourceTitle)"'
    ;;

  status)
    lidarr_curl "/system/status" \
      | jq '{version, buildTime, isProduction, runtimeVersion, startTime}'
    ;;

  refresh)
    lidarr_curl "/command" -X POST -H 'Content-Type: application/json' \
      -d '{"name":"RefreshMonitoredDownloads"}' \
      | jq '{id, status, name}'
    ;;

  scan)
    lidarr_curl "/command" -X POST -H 'Content-Type: application/json' \
      -d '{"name":"RescanFolders"}' \
      | jq '{id, status, name}'
    ;;

  command)
    name=${1:?command requires a NAME}
    body=${2:-}
    if [[ -z "$body" ]]; then
      body=$(printf '{"name":"%s"}' "$name")
    fi
    lidarr_curl "/command" -X POST -H 'Content-Type: application/json' -d "$body" \
      | jq '{id, status, name}'
    ;;

  raw)
    path=${1:?raw requires a PATH}; shift
    lidarr_curl "$path" "$@"
    ;;

  help|--help|-h|"")
    # Print the leading comment block (line 2 onward, stop at first non-#).
    awk 'NR==1{next} /^#/{sub(/^# ?/,""); print; next} {exit}' "$0"
    ;;

  *)
    echo "Unknown subcommand: $cmd" >&2
    exit 1
    ;;
esac
